---
import Base from '../layouts/Base.astro';
import DayView from '../components/DayView.astro';
import { getDayPrices, madridDate, fmtHour, fmtPrice, fmtLongDate } from '../lib/pvpc';

export const prerender = false;

const date = madridDate(1);
const day = await getDayPrices(date);
Astro.response.headers.set('Cache-Control', 'public, max-age=300');

const title = 'Precio de la luz mañana por horas (PVPC) | La factura de la luz';
const description = day
  ? `Precio de la luz mañana: la hora más barata será de ${fmtHour(day.min.hour)} a ${fmtHour(day.min.hour + 1)} (${fmtPrice(day.min.price)} €/kWh). Precio PVPC hora a hora.`
  : 'Precio de la luz mañana hora a hora (PVPC). Red Eléctrica lo publica cada día hacia las 20:15.';
---
<Base title={title} description={description}>
  {day ? (
    <DayView day={day} when="mañana" />
  ) : (
    <section class="empty">
      <h1>Precio de la luz mañana, {fmtLongDate(date)}</h1>
      <p class="big">Todavía no se ha publicado.</p>
      <p>Red Eléctrica publica los precios del día siguiente cada tarde, hacia las 20:15. Vuelve después de esa hora.</p>
    </section>
  )}
  <p class="next"><a href="/">Ver el precio de la luz hoy</a></p>
</Base>
<style>
  .empty { padding-top: 3rem; }
  .empty h1 { font-size: 1.15rem; font-weight: 600; color: var(--slate); letter-spacing: 0; }
  .big { font-size: clamp(2.4rem, 7vw, 4.6rem); font-weight: 800; line-height: 1; letter-spacing: -0.035em; margin: 0.75rem 0 1.5rem; max-width: 14ch; }
  .next { margin-top: 3rem; font-weight: 600; }
</style>
