---
import Base from '../layouts/Base.astro';
import DayView from '../components/DayView.astro';
import { getDayPrices, getPvpcPeriodAverages, madridDate, madridHour, fmtHour, fmtPrice } from '../lib/pvpc';
import { PERFILES, rankingCompanias, enlaceComparador } from '../lib/ranking';
import { OFERTAS } from '../data/ofertas';
import { salida } from '../lib/salida';
import { eur } from '../lib/calculo';

export const prerender = false;

const date = madridDate();
const day = await getDayPrices(date);
Astro.response.headers.set('Cache-Control', 'public, max-age=300');

// Las tres tarifas más baratas del mes para un hogar típico: mismo cálculo que /compania-luz-mas-barata.
const tipico = PERFILES.find((p) => p.id === 'tipico')!;
const pvpc = await getPvpcPeriodAverages();
const mejores = rankingCompanias(tipico, pvpc).filter((f) => f.oferta).slice(0, 3);
const nTarifas = OFERTAS.filter((o) => !o.oculta).length;

const title = 'Precio de la luz hoy por horas y horas más baratas (PVPC) | La factura de la luz';
const description = day
  ? `Precio de la luz hoy: la hora más barata es de ${fmtHour(day.min.hour)} a ${fmtHour(day.min.hour + 1)} (${fmtPrice(day.min.price)} €/kWh). Precio PVPC hora a hora y cuándo poner la lavadora.`
  : 'Precio de la luz hoy hora a hora (PVPC), con la hora más barata y la más cara del día.';
---
<Base title={title} description={description}>
  {day ? (
    <DayView day={day} when="hoy" currentHour={madridHour()}>
      <section slot="tarifas" class="tarifas">
        <h2>Las tarifas más baratas este mes</h2>
        <p class="nota">Hogar de {tipico.descripcion}, con impuestos. Ordenadas solo por precio.</p>
        <ol>
          {mejores.map((f, i) => {
            const l = salida(f.oferta!, '/');
            return (
              <li>
                <div class="quien">
                  <strong>{f.nombre}</strong>
                  <span class="nota">
                    {f.compania}. {i === 0 ? <span class="badge">La más barata</span> : `${eur(f.total - mejores[0].total)} más al año`}
                  </span>
                </div>
                <div class="cuanto">
                  <strong>{eur(f.total)} al año</strong>
                  <span class="nota">{eur(f.total / 12)} al mes</span>
                </div>
                <div class="accion">
                  <a class="btn" href={l.href} rel={l.rel} target="_blank">Ver tarifa</a>
                  {f.oferta!.afiliado && <span class="nota">Patrocinado</span>}
                </div>
              </li>
            );
          })}
        </ol>
        <p class="mas"><a href={enlaceComparador(tipico)}>Comparar las {nTarifas} tarifas con tu consumo</a></p>
      </section>
    </DayView>
  ) : (
    <section class="empty">
      <h1>Precio de la luz hoy</h1>
      <p>No hemos podido cargar los precios de Red Eléctrica ahora mismo. Recarga la página en unos minutos.</p>
    </section>
  )}
  <p class="next"><a href="/precio-luz-manana">Ver el precio de la luz mañana</a></p>
  <nav class="cias" aria-label="Precio por compañía">
    <h2>¿Eres cliente de una de estas compañías?</h2>
    <ul>
      <li><a href="/precio-luz-hoy-endesa">Precio de la luz hoy en Endesa y Energía XXI</a></li>
      <li><a href="/precio-luz-hoy-iberdrola">Precio de la luz hoy en Iberdrola y Curenergía</a></li>
      <li><a href="/precio-luz-hoy-naturgy">Precio de la luz hoy en Naturgy y su Comercializadora Regulada</a></li>
    </ul>
  </nav>
</Base>
<style>
  .empty { padding-top: 3rem; }
  .empty h1 { font-size: clamp(1.9rem, 5vw, 2.6rem); margin-bottom: 1rem; }
  .next { margin-top: 3rem; font-weight: 600; }
  .cias { margin-top: 2.5rem; }
  .cias h2 { font-size: 1.15rem; }
  .cias ul { padding-left: 1.2rem; }
  .cias li { padding: 0.15rem 0; }
  .tarifas { border-top: 2px solid var(--ink); margin-top: 2.5rem; }
  .tarifas h2 { font-size: clamp(1.4rem, 2.6vw, 1.65rem); margin-top: 1.25rem; margin-bottom: 0.4rem; }
  .nota { color: var(--slate); font-size: 0.9rem; }
  .tarifas ol { list-style: none; margin: 0.5rem 0 0; padding: 0; }
  .tarifas li { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0.6rem 1rem; padding: 1rem 0; border-bottom: 1px solid var(--rule); max-width: none; }
  .quien { flex: 1 1 11rem; display: flex; flex-direction: column; }
  .cuanto { display: flex; flex-direction: column; text-align: right; }
  .cuanto strong { font-family: var(--font-display); font-size: 1.45rem; line-height: 1.15; }
  .accion { display: flex; flex-direction: column; align-items: center; gap: 0.15rem; }
  .mas a { display: inline-block; padding: 0.6rem 0; font-weight: 700; }
</style>
