---
import '@fontsource/bricolage-grotesque/latin-700.css';
import '@fontsource-variable/figtree';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
}
const { title, description, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const path = Astro.url.pathname;
const nav = [
  { href: '/', label: 'Precio hoy' },
  { href: '/precio-luz-manana', label: 'Precio mañana' },
  { href: '/comparador-tarifas-luz', label: 'Comparar tarifas' },
  { href: '#guias', label: 'Guías' },
];
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="La Factura de la Luz" />
    <meta property="og:image" content={new URL('/og.png', Astro.site).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="La Factura de la Luz: el precio de la luz de hoy, hora a hora, en un reloj de 24 horas" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#F6F7F4" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <a class="skip" href="#main">Saltar al contenido</a>
    <header class="site-header">
      <a class="brand" href="/"><span class="brand-mark" aria-hidden="true"></span>La Factura de la Luz</a>
      <nav aria-label="Principal">
        <details class="site-nav" open>
          <summary>Menú</summary>
          <ul>
            {nav.map((item) => (
              <li><a href={item.href} aria-current={path === item.href ? 'page' : undefined}>{item.label}</a></li>
            ))}
          </ul>
        </details>
      </nav>
      <script is:inline>
        // En móvil el menú empieza cerrado; sin JavaScript queda abierto y usable.
        if (window.matchMedia('(max-width: 767px)').matches) document.querySelector('.site-nav').removeAttribute('open');
      </script>
    </header>
    <main id="main">
      <slot />
    </main>
    <script is:inline>
      // Índice lateral en páginas de texto largas, solo en pantallas anchas. Sin JavaScript la página es la de siempre.
      (function () {
        var art = document.querySelector('main > article.prose');
        if (!art) return;
        var hs = art.querySelectorAll('h2');
        if (hs.length < 3) return;
        var main = art.parentElement;
        var aside = document.createElement('aside');
        aside.className = 'indice';
        var nav = document.createElement('nav');
        nav.setAttribute('aria-label', 'En esta página');
        var t = document.createElement('p');
        t.textContent = 'En esta página';
        var ul = document.createElement('ul');
        hs.forEach(function (h, i) {
          if (!h.id) {
            h.id = (h.textContent || '').toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '') || 'seccion-' + i;
          }
          var li = document.createElement('li');
          var a = document.createElement('a');
          a.href = '#' + h.id;
          a.textContent = h.textContent;
          li.appendChild(a);
          ul.appendChild(li);
        });
        nav.appendChild(t);
        nav.appendChild(ul);
        aside.appendChild(nav);
        main.appendChild(aside);
        function place() {
          var left = art.offsetLeft + art.offsetWidth + 72;
          var room = main.clientWidth - left - parseFloat(getComputedStyle(main).paddingRight);
          aside.hidden = room < 200;
          aside.style.left = left + 'px';
          aside.style.width = Math.min(room, 300) + 'px';
          aside.style.top = hs[0].offsetTop + 'px';
        }
        place();
        window.addEventListener('resize', place);
      })();
    </script>
    <footer class="site-footer">
      <p>
        Esta web puede recibir una comisión si contratas una tarifa desde un enlace marcado como patrocinado. No cambia el
        precio que pagas ni el orden de los resultados. <a href="/como-ganamos-dinero">Cómo ganamos dinero</a>.
      </p>
      <nav class="guias" id="guias" aria-label="Guías">
        <a href="/compania-luz-mas-barata">Compañía de luz más barata</a>
        <a href="/consumo">Consumo de electrodomésticos</a>
        <a href="/dar-de-alta-la-luz">Dar de alta la luz</a>
        <a href="/cambio-titular-luz">Cambio de titular</a>
        <a href="/bono-social-luz">Bono social de la luz</a>
        <a href="/que-potencia-contratar">Qué potencia contratar</a>
        <a href="/tarifa-luz-coche-electrico">Tarifa para coche eléctrico</a>
        <a href="/bateria-virtual">Batería virtual</a>
      </nav>
      <nav class="guias" aria-label="Precio por compañía">
        <a href="/precio-luz-hoy-endesa">Precio hoy Endesa</a>
        <a href="/precio-luz-hoy-iberdrola">Precio hoy Iberdrola</a>
        <a href="/precio-luz-hoy-naturgy">Precio hoy Naturgy</a>
      </nav>
      <nav aria-label="Legal">
        <a href="/aviso-legal">Aviso legal</a>
        <a href="/privacidad">Privacidad</a>
        <a href="/cookies">Cookies</a>
      </nav>
    </footer>
  </body>
</html>
